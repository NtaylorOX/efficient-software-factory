# Copy to .env (git-ignored). Nothing here is ever passed to an agent process.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-...                  # a LiteLLM virtual key, not a provider key
# claude-code backend: the only credential the `claude` process receives, renamed to ANTHROPIC_API_KEY.
# Point it at the LiteLLM proxy too, so the agent never holds a provider key.
FACTORY_ANTHROPIC_API_KEY=sk-...
FACTORY_ANTHROPIC_BASE_URL=http://localhost:4000
# GitHub mode (set `repo:` in factory.yaml). Fine-grained PAT: issues read/write, contents and PRs write.
FACTORY_GITHUB_TOKEN=github_pat_...
